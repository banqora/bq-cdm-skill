#!/usr/bin/env bash
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

status=0
for suite in "$script_dir"/*.test.sh; do
  echo "== $(basename -- "$suite") =="
  "$suite" || status=1
  echo
done

if [[ "$status" -eq 0 ]]; then
  echo "tests/run: all suites passed"
else
  echo "tests/run: at least one suite failed" >&2
fi
exit "$status"
