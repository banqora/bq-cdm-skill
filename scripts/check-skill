#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "$script_dir/.." && pwd)"
skill_root="$repo_root/skills/cdm-dev"

usage() {
  cat >&2 <<'USAGE'
Usage:
  check-skill --static
  check-skill --jar <cdm-java.jar>

--static validates the portable skill structure, references, and scripts.
--jar also validates the helper and model assumptions against the supplied dependency.
USAGE
}

mode="${1:-}"
jar_path=""
case "$mode" in
  --static)
    [[ $# -eq 1 ]] || {
      usage
      exit 1
    }
    ;;
  --jar)
    [[ $# -eq 2 ]] || {
      usage
      exit 1
    }
    jar_path="$2"
    ;;
  -h | --help | help | '')
    usage
    exit 0
    ;;
  *)
    echo "check-skill: unknown option '$mode'" >&2
    usage
    exit 1
    ;;
esac

bash -n "$skill_root/scripts/cdm-source"
bash -n "$repo_root/scripts/check-skill"

python3 - "$skill_root" "$repo_root" <<'PY'
import ast
import json
import os
import re
import sys
from pathlib import Path

# Resolve eagerly: the skill may be reached through a symlinked install path,
# and later link checks compare resolved targets against paths rooted here.
skill_dir = Path(sys.argv[1]).resolve()
repo_root = Path(sys.argv[2]).resolve()
skill = skill_dir / "SKILL.md"
if not skill.is_file():
    raise SystemExit("check-skill: skills/cdm-dev/SKILL.md is missing")

text = skill.read_text()
lines = text.splitlines()
if not lines or lines[0] != "---":
    raise SystemExit("check-skill: SKILL.md has no YAML frontmatter")
try:
    closing = lines[1:].index("---") + 1
except ValueError:
    raise SystemExit("check-skill: SKILL.md frontmatter is not closed")

frontmatter = lines[1:closing]
keys = [line.split(":", 1)[0] for line in frontmatter if line.strip()]
if keys != ["name", "description"]:
    raise SystemExit(f"check-skill: frontmatter keys must be name, description; got {keys}")
if "name: cdm-dev" not in frontmatter:
    raise SystemExit("check-skill: skill name is not cdm-dev")
if skill_dir.name != "cdm-dev":
    raise SystemExit("check-skill: the Agent Skills spec requires the directory containing "
                     f"SKILL.md to be named cdm-dev; got {skill_dir.name}")
description = next((line.split(":", 1)[1].strip() for line in frontmatter
                    if line.startswith("description:")), "")
if len(description) < 80:
    raise SystemExit("check-skill: description is too weak to route development tasks")
if len(description) > 1024:
    raise SystemExit(f"check-skill: description is {len(description)} chars; the Agent Skills "
                     "spec caps it at 1024 and Codex truncates long descriptions first")
if len(lines) > 120:
    raise SystemExit(f"check-skill: SKILL.md has {len(lines)} lines; move detail to references")

ui_metadata = skill_dir / "agents" / "openai.yaml"
if not ui_metadata.is_file():
    raise SystemExit("check-skill: agents/openai.yaml is missing")
ui_lines = [line for line in ui_metadata.read_text().splitlines() if line.strip()]
if not ui_lines or ui_lines[0] != "interface:":
    raise SystemExit("check-skill: agents/openai.yaml must contain an interface mapping")
interface = {}
interface_line = re.compile(r'  ([a-z_]+): ("(?:[^"\\]|\\.)*")')
for line in ui_lines[1:]:
    match = interface_line.fullmatch(line)
    if not match:
        raise SystemExit("check-skill: agents/openai.yaml interface values must be quoted "
                         f"strings with two-space indentation; got {line!r}")
    key, encoded_value = match.groups()
    if key in interface:
        raise SystemExit(f"check-skill: agents/openai.yaml repeats interface.{key}")
    try:
        interface[key] = json.loads(encoded_value)
    except json.JSONDecodeError as error:
        raise SystemExit(f"check-skill: agents/openai.yaml has invalid interface.{key}: "
                         f"{error.msg}")
required_interface_keys = ["display_name", "short_description", "default_prompt"]
if list(interface) != required_interface_keys:
    raise SystemExit("check-skill: agents/openai.yaml interface keys must be "
                     f"{', '.join(required_interface_keys)}; got {', '.join(interface)}")
if not interface["display_name"].strip():
    raise SystemExit("check-skill: agents/openai.yaml display_name must not be empty")
short_description = interface["short_description"].strip()
if not 25 <= len(short_description) <= 64:
    raise SystemExit("check-skill: agents/openai.yaml short_description must be 25-64 "
                     f"characters; got {len(short_description)}")
default_prompt = interface["default_prompt"].strip()
if "$cdm-dev" not in default_prompt:
    raise SystemExit("check-skill: agents/openai.yaml default_prompt must mention $cdm-dev")
if not re.fullmatch(r"[^.!?]+[.!?]", default_prompt):
    raise SystemExit("check-skill: agents/openai.yaml default_prompt must be one sentence")

readme = repo_root / "README.md"
link_re = re.compile(r"\]\(([^)#]+\.md)(?:#[^)]*)?\)")
missing = []
for markdown in [*skill_dir.rglob("*.md"), readme]:
    for link in link_re.findall(markdown.read_text()):
        if "://" in link:
            continue
        target = (markdown.parent / link).resolve()
        if not target.is_file():
            missing.append(f"{markdown.relative_to(repo_root)} -> {link}")
if missing:
    raise SystemExit("check-skill: missing Markdown references:\n  " + "\n  ".join(missing))

references = set((skill_dir / "references").rglob("*.md"))
required_reference_names = {
    "assets-and-cash-securities.md",
    "commodities.md",
    "conformance.md",
    "credit-derivatives.md",
    "dialects.md",
    "equities.md",
    "foreign-exchange.md",
    "industry-bodies.md",
    "interest-rates.md",
    "legal-contracts.md",
    "onboarding.md",
    "regulatory-reporting.md",
    "rosetta.md",
    "securities-financing.md",
    "testing.md",
    "workflows.md",
}
missing_required = sorted(required_reference_names - {path.name for path in references})
if missing_required:
    raise SystemExit("check-skill: required domain references are missing:\n  " +
                     "\n  ".join(missing_required))
linked_references = set()
pending = [skill]
visited = set()
while pending:
    markdown = pending.pop()
    if markdown in visited:
        continue
    visited.add(markdown)
    for link in link_re.findall(markdown.read_text()):
        target = (markdown.parent / link).resolve()
        try:
            target.relative_to((skill_dir / "references").resolve())
        except ValueError:
            continue
        if target.is_file() and target not in linked_references:
            linked_references.add(target)
            pending.append(target)
orphans = sorted(path.relative_to(skill_dir) for path in references - linked_references)
if orphans:
    raise SystemExit("check-skill: orphan references not reachable from SKILL.md:\n  " +
                     "\n  ".join(map(str, orphans)))

for reference in references:
    reference_lines = reference.read_text().strip().splitlines()
    if len(reference_lines) < 8:
        raise SystemExit(f"check-skill: reference is an empty stub: {reference.relative_to(skill_dir)}")
    if len(reference_lines) <= 100:
        continue

    contents_indices = [index for index, line in enumerate(reference_lines)
                        if line == "## Contents"]
    relative_reference = reference.relative_to(skill_dir)
    if len(contents_indices) != 1:
        raise SystemExit("check-skill: references over 100 lines need one ## Contents "
                         f"section: {relative_reference}")
    contents_index = contents_indices[0]
    h2_indices = [index for index, line in enumerate(reference_lines)
                  if line.startswith("## ")]
    if not h2_indices or contents_index != h2_indices[0]:
        raise SystemExit("check-skill: ## Contents must be the first level-two section in "
                         f"{relative_reference}")
    next_h2 = next((index for index in h2_indices if index > contents_index),
                   len(reference_lines))
    toc_lines = [line for line in reference_lines[contents_index + 1:next_h2]
                 if line.strip()]
    toc_link_re = re.compile(r"- \[[^]]+\]\(#([a-z0-9-]+)\)")
    toc_targets = []
    for line in toc_lines:
        match = toc_link_re.fullmatch(line)
        if not match:
            raise SystemExit("check-skill: invalid Contents entry in "
                             f"{relative_reference}: {line!r}")
        toc_targets.append(match.group(1))

    anchor_counts = {}
    expected_targets = []
    for index in h2_indices[1:]:
        heading = reference_lines[index][3:].strip().lower()
        base_anchor = re.sub(r"[^a-z0-9 _-]", "", heading)
        base_anchor = re.sub(r"[ _]+", "-", base_anchor).strip("-")
        duplicate = anchor_counts.get(base_anchor, 0)
        anchor_counts[base_anchor] = duplicate + 1
        expected_targets.append(base_anchor if duplicate == 0
                                else f"{base_anchor}-{duplicate}")
    if toc_targets != expected_targets:
        raise SystemExit("check-skill: Contents targets do not match level-two headings in "
                         f"{relative_reference}; expected {expected_targets}, got {toc_targets}")

source_helper = skill_dir / "scripts" / "cdm-source"
checker = repo_root / "scripts" / "check-skill"
link_checker = repo_root / "scripts" / "check-links"
for script in (source_helper, checker, link_checker):
    if not script.is_file() or not os.access(script, os.X_OK):
        raise SystemExit(f"check-skill: {script.relative_to(repo_root)} is missing or not executable")
try:
    ast.parse(link_checker.read_text(), filename=str(link_checker))
except SyntaxError as error:
    raise SystemExit(f"check-skill: scripts/check-links has invalid Python: {error}")

portable_resources = [skill, ui_metadata, readme, source_helper, link_checker,
                      *sorted(references)]
resource_text = "\n".join(path.read_text() for path in portable_resources)
forbidden = {
    "absolute user path": r"/Users/",
    "source repository name": r"bq-cdm",
    "application package": r"com\.banqora",
    "application build wrapper": r"docker/gradle\.sh",
    "application path helper": r"\b(?:CdmPathModel|ModelShape|ShapeBuilder|LifecycleService)\b",
    "old repository selector": r"(?:CDM_REPO|--repo)",
}
for label, pattern in forbidden.items():
    if re.search(pattern, resource_text, flags=re.IGNORECASE):
        raise SystemExit(f"check-skill: repository resources contain {label}; keep the skill generic")
if re.search(r"cdm-java-\d+\.\d+(?:\.\d+)?\.jar", resource_text):
    raise SystemExit("check-skill: an agent resource hard-codes a released cdm-java filename")

print(
    f"check-skill: static contract passed "
    f"({len(lines)} SKILL.md lines, {len(references)} reachable references, valid UI metadata)"
)
PY

if [[ "$mode" == "--static" ]]; then
  exit 0
fi

source_helper="$skill_root/scripts/cdm-source"
jar="$("$source_helper" --jar "$jar_path" jar)"
jar_entries="$(zipinfo -1 "$jar")"
source_count="$(rg '^cdm/rosetta/.*\.rosetta$' <<<"$jar_entries" | wc -l | tr -d ' ')"
# Supported releases range from 86 sources (cdm-java 4.x/5.x) to 187+ (6.x/7.x).
[[ "$source_count" -ge 50 ]] || {
  echo "check-skill: cdm-java exposes only $source_count Rosetta sources" >&2
  exit 1
}

"$source_helper" --jar "$jar" search '^type TradeState:' >/dev/null
"$source_helper" --jar "$jar" search 'func Qualify_' >/dev/null

# The conformance reference depends on this corpus being discoverable; its
# prefix moves between releases, so match the family path anywhere in the JAR.
rg 'functions/repo-and-bond/' <<<"$jar_entries" >/dev/null || {
  echo "check-skill: no discoverable repo-and-bond functions corpus in $jar" >&2
  exit 1
}

echo "check-skill: live contract passed against $jar ($source_count Rosetta sources)"
