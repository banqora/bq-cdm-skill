#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
Usage:
  cdm-java-api [--jar <cdm-java.jar>] [--classpath <path>] <Type|fully.qualified.Type>...

Print the public generated Java API for each requested type. When the selected cdm-java JAR
contains a matching nested <Type>$<Type>Builder or <Type>$<Type>Default class, print it in the same
javap pass.
An unqualified simple name is resolved from the selected JAR when it has exactly one match; the
resolved fully qualified Java name is printed before the API. Ambiguous names fail with candidates.

The cdm-java JAR is selected by the adjacent cdm-source helper. Repeat --classpath to add
project-resolved runtime dependencies, or set CDM_JAVA_CLASSPATH. The helper never downloads or
guesses a dependency version. A call accepts at most eight requested types and emits at most 1,200
lines; it fails atomically rather than truncating an exact API.
USAGE
}

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source_helper="$script_dir/cdm-source"
jar_args=()
extra_classpath="${CDM_JAVA_CLASSPATH:-}"
requested_types=()

append_classpath() {
  local entry="$1"
  [[ -n "$entry" ]] || {
    echo "cdm-java-api: --classpath needs a non-empty path" >&2
    exit 1
  }
  if [[ -n "$extra_classpath" ]]; then
    extra_classpath+=":$entry"
  else
    extra_classpath="$entry"
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --jar)
      [[ $# -ge 2 ]] || {
        echo "cdm-java-api: --jar needs a path" >&2
        exit 1
      }
      jar_args=(--jar "$2")
      shift 2
      ;;
    --classpath)
      [[ $# -ge 2 ]] || {
        echo "cdm-java-api: --classpath needs a path" >&2
        exit 1
      }
      append_classpath "$2"
      shift 2
      ;;
    -h | --help | help)
      usage
      exit 0
      ;;
    --)
      shift
      requested_types+=("$@")
      break
      ;;
    -*)
      echo "cdm-java-api: unknown option '$1'" >&2
      usage
      exit 1
      ;;
    *)
      requested_types+=("$1")
      shift
      ;;
  esac
done

[[ ${#requested_types[@]} -gt 0 ]] || {
  echo "cdm-java-api: provide at least one Java type" >&2
  usage
  exit 1
}
if [[ ${#requested_types[@]} -gt 8 ]]; then
  echo "cdm-java-api: at most 8 Java types are allowed per bounded inspection" >&2
  echo "cdm-java-api: split the request into a smaller API slice" >&2
  exit 1
fi

for required_tool in javap zipinfo rg; do
  command -v "$required_tool" >/dev/null || {
    echo "cdm-java-api: required command is not installed: $required_tool" >&2
    exit 1
  }
done

if ! javap_probe="$(javap -version 2>&1)"; then
  echo "cdm-java-api: javap was found but no working JDK is configured" >&2
  echo "cdm-java-api: install a JDK, then set JAVA_HOME and put its bin directory first on PATH" >&2
  [[ -z "$javap_probe" ]] || printf 'cdm-java-api: javap: %s\n' "$javap_probe" >&2
  exit 1
fi

if [[ ${#jar_args[@]} -gt 0 ]]; then
  jar="$("$source_helper" "${jar_args[@]}" jar)"
else
  # Bash 3.2 treats an empty array expansion as unbound under `set -u`.
  jar="$("$source_helper" jar)"
fi
jar_entries="$(zipinfo -1 "$jar")"
targets=()
resolution_notes=()
resolution_errors=()

add_target() {
  local candidate="$1"
  local existing
  for existing in "${targets[@]:-}"; do
    [[ "$existing" == "$candidate" ]] && return
  done
  targets+=("$candidate")
}

for requested_type in "${requested_types[@]}"; do
  if [[ ! "$requested_type" =~ ^[A-Za-z_$][A-Za-z0-9_$]*(\.[A-Za-z_$][A-Za-z0-9_$]*)*$ ]]; then
    resolution_errors+=("invalid Java type: $requested_type")
    continue
  fi

  resolved_type="$requested_type"
  if [[ "$requested_type" != *.* ]]; then
    simple_matches=()
    while IFS= read -r entry; do
      case "$entry" in
        */"$requested_type".class)
          match="${entry%.class}"
          simple_matches+=("${match//\//.}")
          ;;
      esac
    done <<<"$jar_entries"
    if [[ ${#simple_matches[@]} -eq 0 ]]; then
      resolution_errors+=("Java type not found in selected JAR: $requested_type")
      continue
    fi
    if [[ ${#simple_matches[@]} -gt 1 ]]; then
      sorted_matches="$(printf '    %s\n' "${simple_matches[@]}" | sort)"
      resolution_errors+=("Java type name is ambiguous; use a fully qualified name: $requested_type"$'\n'"$sorted_matches")
      continue
    fi
    resolved_type="${simple_matches[0]}"
    resolution_notes+=("# requested=$requested_type resolved=$resolved_type")
  fi

  add_target "$resolved_type"

  if [[ "$resolved_type" != *'$'* ]]; then
    simple_name="${resolved_type##*.}"
    builder_type="${resolved_type}\$${simple_name}Builder"
    builder_entry="${builder_type//.//}.class"
    if rg -Fx -- "$builder_entry" <<<"$jar_entries" >/dev/null; then
      add_target "$builder_type"
    fi

    default_type="${resolved_type}\$${simple_name}Default"
    default_entry="${default_type//.//}.class"
    if rg -Fx -- "$default_entry" <<<"$jar_entries" >/dev/null; then
      add_target "$default_type"
    fi
  fi
done

if [[ ${#resolution_errors[@]} -gt 0 ]]; then
  echo "cdm-java-api: type batch preflight failed:" >&2
  printf '  %s\n' "${resolution_errors[@]}" >&2
  exit 1
fi

classpath="$jar"
[[ -z "$extra_classpath" ]] || classpath+=":$extra_classpath"

if ! api="$(javap -public -classpath "$classpath" "${targets[@]}" 2>&1)"; then
  printf '%s\n' "$api" >&2
  if rg -q 'class not found: com\.rosetta\.model\.lib\.' <<<"$api"; then
    echo "cdm-java-api: com.rosetta.model.lib runtime support types are not in cdm-java;" >&2
    echo "cdm-java-api: add the project's resolved rune-runtime JAR with --classpath" >&2
    echo "cdm-java-api: do not search global caches or guess a runtime version; compile the project slice if its resolved classpath is not ready" >&2
  else
    echo "cdm-java-api: add missing project-resolved dependencies with --classpath; do not guess versions" >&2
  fi
  exit 1
fi

api_lines="$(awk 'END { print NR }' <<<"$api")"
line_count=$((api_lines + ${#resolution_notes[@]}))
if [[ "$line_count" -gt 1200 ]]; then
  echo "cdm-java-api: exact API inspection would emit $line_count lines (limit 1200)" >&2
  echo "cdm-java-api: request a smaller type batch; output was not truncated" >&2
  exit 1
fi

if [[ ${#resolution_notes[@]} -gt 0 ]]; then
  printf '%s\n' "${resolution_notes[@]}"
fi
printf '%s\n' "$api"
