#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
Usage:
  cdm-source [--jar <cdm-java.jar>] version
  cdm-source [--jar <cdm-java.jar>] jar
  cdm-source [--jar <cdm-java.jar>] list [regex]
  cdm-source [--jar <cdm-java.jar>] search <regex>
  cdm-source [--jar <cdm-java.jar>] type <fully.qualified.Declaration|Declaration>...
  cdm-source [--jar <cdm-java.jar>] show <cdm/rosetta/file.rosetta>

The JAR is selected in this order:
  1. --jar
  2. CDM_JAVA_JAR
  3. an unambiguous cdm-java JAR in a common build layout under the active project

The helper never downloads or substitutes a CDM release.
USAGE
}

jar_override=""
if [[ "${1:-}" == "--jar" ]]; then
  [[ $# -ge 3 ]] || {
    echo "cdm-source: --jar needs a path and a command" >&2
    exit 1
  }
  jar_override="$2"
  shift 2
fi

command="${1:-}"
if [[ -z "$command" || "$command" == "-h" || "$command" == "--help" || "$command" == "help" ]]; then
  usage
  exit 0
fi

for required_tool in python3 zipinfo unzip rg; do
  command -v "$required_tool" >/dev/null || {
    echo "cdm-source: required command is not installed: $required_tool" >&2
    exit 1
  }
done

canonical_file() {
  local requested="$1"
  local directory
  local filename
  directory="$(cd -- "$(dirname -- "$requested")" 2>/dev/null && pwd -P)" || return 1
  filename="$(basename -- "$requested")"
  [[ -f "$directory/$filename" ]] || return 1
  printf '%s/%s\n' "$directory" "$filename"
}

project_root() {
  local candidate="$PWD"
  while :; do
    if [[ -d "$candidate/.git" ||
      -f "$candidate/settings.gradle" ||
      -f "$candidate/settings.gradle.kts" ||
      -f "$candidate/pom.xml" ||
      -f "$candidate/build.gradle" ||
      -f "$candidate/build.gradle.kts" ]]; then
      printf '%s\n' "$candidate"
      return
    fi
    local parent
    parent="$(dirname -- "$candidate")"
    [[ "$parent" != "$candidate" ]] || break
    candidate="$parent"
  done
  printf '%s\n' "$PWD"
}

discover_jar() {
  local root
  root="$(project_root)"
  local candidates=()
  local candidate
  local canonical

  while IFS= read -r candidate; do
    if [[ "$candidate" == *"/.git/"* ||
      "$candidate" == *"/.claude/"* ||
      "$candidate" == *"/.codex/"* ||
      "$candidate" == *"/node_modules/"* ]]; then
      continue
    fi
    if [[ "$candidate" != *"/build/install/"*"/lib/cdm-java-"*.jar &&
      "$candidate" != *"/build/distributions/"*"/lib/cdm-java-"*.jar &&
      "$candidate" != *"/target/dependency/cdm-java-"*.jar &&
      "$candidate" != *"/target/lib/cdm-java-"*.jar &&
      "$candidate" != *"/lib/cdm-java-"*.jar ]]; then
      continue
    fi
    case "$(basename -- "$candidate")" in
      *-sources.jar | *-javadoc.jar | *-tests.jar)
        continue
        ;;
    esac
    canonical="$(canonical_file "$candidate")" || continue
    local duplicate=false
    local existing
    for existing in "${candidates[@]:-}"; do
      if [[ "$existing" == "$canonical" ]]; then
        duplicate=true
        break
      fi
    done
    [[ "$duplicate" == true ]] || candidates+=("$canonical")
  done < <(
    find "$root" \
      \( -type d \( -name .git -o -name .claude -o -name .codex -o -name node_modules \) -prune \) -o \
      \( -type f -name 'cdm-java-*.jar' -print \) 2>/dev/null |
      sort
  )

  if [[ ${#candidates[@]} -eq 0 ]]; then
    echo "cdm-source: no cdm-java JAR found under $root" >&2
    echo "cdm-source: build or copy the project's dependency, then pass --jar or set CDM_JAVA_JAR" >&2
    return 1
  fi
  if [[ ${#candidates[@]} -gt 1 ]]; then
    echo "cdm-source: multiple cdm-java JARs found; choose the project's active dependency with --jar:" >&2
    printf '  %s\n' "${candidates[@]}" >&2
    return 1
  fi
  printf '%s\n' "${candidates[0]}"
}

requested_jar="${jar_override:-${CDM_JAVA_JAR:-}}"
if [[ -n "$requested_jar" ]]; then
  jar="$(canonical_file "$requested_jar")" || {
    echo "cdm-source: JAR does not exist: $requested_jar" >&2
    exit 1
  }
else
  jar="$(discover_jar)"
fi

case "$(basename -- "$jar")" in
  cdm-java-*-sources.jar)
    echo "cdm-source: pass the binary cdm-java JAR, which embeds the Rune .rosetta sources" >&2
    echo "cdm-source: the -sources.jar contains generated Java source; use cdm-java-api for signatures" >&2
    exit 1
    ;;
esac

if ! jar_entries="$(zipinfo -1 "$jar" 2>/dev/null)"; then
  echo "cdm-source: not a readable JAR/ZIP: $jar" >&2
  exit 1
fi
if ! rg '^cdm/rosetta/.*\.rosetta$' <<<"$jar_entries" >/dev/null; then
  echo "cdm-source: JAR contains no embedded cdm/rosetta sources: $jar" >&2
  exit 1
fi

jar_name="$(basename -- "$jar")"
if [[ "$jar_name" == cdm-java-*.jar ]]; then
  cdm_version="${jar_name#cdm-java-}"
  cdm_version="${cdm_version%.jar}"
else
  cdm_version="$(
    (unzip -p "$jar" META-INF/MANIFEST.MF 2>/dev/null || true) |
      tr -d '\r' |
      sed -n 's/^Implementation-Version: //p' |
      head -n 1
  )"
  cdm_version="${cdm_version:-unknown}"
fi

case "$command" in
  version)
    [[ $# -eq 1 ]] || {
      usage
      exit 1
    }
    printf 'version=%s\njar=%s\n' "$cdm_version" "$jar"
    ;;

  jar)
    [[ $# -eq 1 ]] || {
      usage
      exit 1
    }
    printf '%s\n' "$jar"
    ;;

  list)
    [[ $# -le 2 ]] || {
      usage
      exit 1
    }
    pattern="${2:-.}"
    rg '^cdm/rosetta/.*\.rosetta$' <<<"$jar_entries" | rg -- "$pattern"
    ;;

  search)
    [[ $# -eq 2 ]] || {
      usage
      exit 1
    }
    pattern="$2"
    source_dir="$(mktemp -d "${TMPDIR:-/tmp}/cdm-source.XXXXXX")"
    cleanup() {
      [[ -n "${source_dir:-}" && -d "$source_dir" ]] && rm -rf -- "$source_dir"
    }
    trap cleanup EXIT
    unzip -q "$jar" 'cdm/rosetta/*.rosetta' -d "$source_dir"
    (
      cd "$source_dir"
      rg -n -C 3 --glob '*.rosetta' -- "$pattern" cdm/rosetta
    )
    ;;

  type)
    [[ $# -ge 2 ]] || {
      usage
      exit 1
    }
    requested_declarations=("${@:2}")
    for requested_declaration in "${requested_declarations[@]}"; do
      if [[ ! "$requested_declaration" =~ ^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)*$ ]]; then
        echo "cdm-source: invalid declaration name: $requested_declaration" >&2
        exit 1
      fi
    done
    python3 - "$jar" "${requested_declarations[@]}" <<'PY'
from __future__ import annotations

import re
import sys
import zipfile
from dataclasses import dataclass


@dataclass(frozen=True)
class Declaration:
    kind: str
    namespace: str
    name: str
    base: str | None
    imports: tuple[str, ...]
    path: str
    line: int
    block: tuple[str, ...]


jar_path = sys.argv[1]
requested_declarations = sys.argv[2:]
declaration_re = re.compile(
    r"^(type|choice|enum)\s+([A-Za-z_][A-Za-z0-9_]*)"
    r"(?:\s+extends\s+([A-Za-z_][A-Za-z0-9_]*))?\s*:"
)
top_level_re = re.compile(r"^(?:type|enum|choice|func|qualification|report|rule)\s+")
declarations: list[Declaration] = []

with zipfile.ZipFile(jar_path) as archive:
    source_names = sorted(
        name
        for name in archive.namelist()
        if name.startswith("cdm/rosetta/") and name.endswith(".rosetta")
    )
    for path in source_names:
        lines = archive.read(path).decode("utf-8").splitlines()
        namespace = ""
        for line in lines:
            match = re.match(r"^namespace\s+([A-Za-z_][A-Za-z0-9_.]*)\b", line)
            if match:
                namespace = match.group(1)
                break
        imports = tuple(
            match.group(1)
            for line in lines
            if (
                match := re.match(
                    r"^import\s+([A-Za-z_][A-Za-z0-9_.]*(?:\.\*)?)\s*$", line
                )
            )
        )
        for index, line in enumerate(lines):
            match = declaration_re.match(line)
            if not match:
                continue
            end = index + 1
            while end < len(lines) and not top_level_re.match(lines[end]):
                end += 1
            while end > index + 1 and not lines[end - 1].strip():
                end -= 1
            declarations.append(
                Declaration(
                    match.group(1),
                    namespace,
                    match.group(2),
                    match.group(3),
                    imports,
                    path,
                    index + 1,
                    tuple(lines[index:end]),
                )
            )


def qualified(declaration: Declaration) -> str:
    return f"{declaration.namespace}.{declaration.name}" if declaration.namespace else declaration.name


def resolve_requested(requested: str) -> Declaration:
    if "." in requested:
        requested_namespace, requested_name = requested.rsplit(".", 1)
        matches = [
            declaration
            for declaration in declarations
            if declaration.name == requested_name
            and declaration.namespace == requested_namespace
        ]
    else:
        matches = [
            declaration for declaration in declarations if declaration.name == requested
        ]

    if not matches:
        raise SystemExit(f"cdm-source: declaration not found: {requested}")
    if len(matches) > 1:
        options = "\n  ".join(sorted(qualified(declaration) for declaration in matches))
        raise SystemExit(
            "cdm-source: declaration name is ambiguous; use a fully qualified name:"
            f"\n  {options}"
        )
    return matches[0]


# Resolve the complete batch before printing, so an invalid later request cannot leave a
# plausible-looking partial result on stdout.
targets = [(requested, resolve_requested(requested)) for requested in requested_declarations]


def resolve_base(declaration: Declaration) -> Declaration | None:
    if declaration.base is None:
        return None
    same_namespace = [
        candidate
        for candidate in declarations
        if candidate.name == declaration.base and candidate.namespace == declaration.namespace
    ]
    if len(same_namespace) == 1:
        return same_namespace[0]
    global_matches = [candidate for candidate in declarations if candidate.name == declaration.base]
    return global_matches[0] if len(global_matches) == 1 else None


def resolve_field_type(owner: Declaration, name: str) -> Declaration | None:
    same_namespace = [
        candidate
        for candidate in declarations
        if candidate.name == name and candidate.namespace == owner.namespace
    ]
    if len(same_namespace) == 1:
        return same_namespace[0]

    imported: list[Declaration] = []
    for declaration_import in owner.imports:
        if declaration_import.endswith(".*"):
            imported_namespace = declaration_import[:-2]
            imported.extend(
                candidate
                for candidate in declarations
                if candidate.name == name and candidate.namespace == imported_namespace
            )
        elif declaration_import.endswith(f".{name}"):
            imported.extend(
                candidate for candidate in declarations if qualified(candidate) == declaration_import
            )
    imported = list({qualified(candidate): candidate for candidate in imported}.values())
    if len(imported) == 1:
        return imported[0]

    global_matches = [candidate for candidate in declarations if candidate.name == name]
    return global_matches[0] if len(global_matches) == 1 else None


condition_re = re.compile(r"^\s+condition\s+([A-Za-z_][A-Za-z0-9_]*)\s*:")
field_re = re.compile(
    r"^\s+(?:override\s+)?([a-z][A-Za-z0-9_]*)\s+([A-Z][A-Za-z0-9_]*)\s+\([^)]+\)"
)


def declared_conditions(declaration: Declaration) -> tuple[str, ...]:
    return tuple(
        match.group(1)
        for line in declaration.block
        if (match := condition_re.match(line))
    )


def condition_chain(declaration: Declaration) -> list[tuple[Declaration, tuple[str, ...]]]:
    result: list[tuple[Declaration, tuple[str, ...]]] = []
    seen_conditions: set[str] = set()
    current: Declaration | None = declaration
    while current is not None and qualified(current) not in seen_conditions:
        seen_conditions.add(qualified(current))
        conditions = declared_conditions(current)
        if conditions:
            result.append((current, conditions))
        current = resolve_base(current)
    return result


def print_declaration(label: str, declaration: Declaration) -> None:
    print(f"## {label}: {qualified(declaration)}")
    print(f"# source={declaration.path}:{declaration.line}")
    print("\n".join(declaration.block))


def print_target(requested: str, target: Declaration) -> None:
    print(f"# requested={requested}")
    print(f"# resolved={qualified(target)} kind={target.kind}")
    print_declaration("declaration", target)
    seen = {qualified(target)}
    owners = [target]
    base = resolve_base(target)
    direct_base = base
    while base is not None and qualified(base) not in seen:
        seen.add(qualified(base))
        owners.append(base)
        print()
        print_declaration("inherited", base)
        base = resolve_base(base)

    if direct_base is not None:
        siblings = sorted(
            (
                candidate
                for candidate in declarations
                if candidate.base == direct_base.name
                and candidate.namespace == target.namespace
            ),
            key=lambda candidate: candidate.name,
        )
        if siblings:
            print()
            print(f"## sibling types extending {qualified(direct_base)}")
            for sibling in siblings:
                print(
                    f"{qualified(sibling)}  # {sibling.path}:{sibling.line}"
                )
                print(sibling.block[0])

    if target.kind == "choice":
        alternatives: dict[str, Declaration] = {}
        for line in target.block[1:]:
            alternative_match = re.match(r"^\s+([A-Z][A-Za-z0-9_]*)\b", line)
            if not alternative_match:
                continue
            alternative = resolve_field_type(target, alternative_match.group(1))
            if alternative is not None:
                alternatives[qualified(alternative)] = alternative
        if alternatives:
            print()
            print("## choice alternatives")
            for alternative in sorted(alternatives.values(), key=qualified):
                print(
                    f"{qualified(alternative)}  # {alternative.path}:{alternative.line}"
                )

    conditioned_fields: list[
        tuple[
            Declaration,
            str,
            Declaration,
            list[tuple[Declaration, tuple[str, ...]]],
        ]
    ] = []
    seen_fields: set[tuple[str, str, str]] = set()
    for owner in owners:
        for line in owner.block:
            field_match = field_re.match(line)
            if not field_match:
                continue
            field_name, field_type_name = field_match.groups()
            child = resolve_field_type(owner, field_type_name)
            if child is None:
                continue
            child_conditions = condition_chain(child)
            key = (qualified(owner), field_name, qualified(child))
            if child_conditions and key not in seen_fields:
                seen_fields.add(key)
                conditioned_fields.append((owner, field_name, child, child_conditions))

    if conditioned_fields:
        print()
        print("## conditioned field types (parent validation does not recurse)")
        for owner, field_name, child, child_conditions in conditioned_fields:
            print(f"{qualified(owner)}.{field_name} -> {qualified(child)}")
            for condition_owner, conditions in child_conditions:
                joined = ", ".join(conditions)
                print(
                    f"  {qualified(condition_owner)} conditions: {joined}"
                    f"  # {condition_owner.path}:{condition_owner.line}"
                )


for index, (requested, target) in enumerate(targets):
    if index:
        print("\n# ---- next requested declaration ----")
    print_target(requested, target)

print()
print("# next=use one cdm-inspect batch, then compile a populated slice")
PY
    printf '# artifact-version=%s\n# artifact-jar=%s\n' "$cdm_version" "$jar"
    ;;

  show)
    [[ $# -eq 2 ]] || {
      usage
      exit 1
    }
    entry="$2"
    if ! rg -Fx -- "$entry" <<<"$jar_entries" >/dev/null; then
      echo "cdm-source: '$entry' is not a Rosetta source in $jar" >&2
      echo "cdm-source: use 'cdm-source list <regex>' to locate it" >&2
      exit 2
    fi
    unzip -p "$jar" "$entry"
    ;;

  *)
    echo "cdm-source: unknown command '$command'" >&2
    usage
    exit 1
    ;;
esac
